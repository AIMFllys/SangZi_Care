# =============================================
# 桑梓智护 · 环境变量模板
# 复制为 .env.local（本地）并在 EdgeOne 控制台配置同名键
# 切勿提交真实密钥
# =============================================

# --- Supabase（新密钥体系）---
# 客户端：publishable（sb_publishable_...），替代旧 anon JWT
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# 仅服务端：secret（sb_secret_...），替代旧 service_role JWT
SUPABASE_SECRET_KEY=
# 私有 Storage bucket；必须在 Supabase 中预先创建并保持 private
SUPABASE_VOICE_BUCKET=

# --- 应用 URL（Android 壳 / 文档对齐）---
NEXT_PUBLIC_APP_URL=http://localhost:7742

# --- API 基址（同源）---
# API 已迁入 Next.js 同源；留空即可。仅调试旧 Python 时指向 http://localhost:8000
NEXT_PUBLIC_API_BASE_URL=

# --- 以下在 API 迁入 Next 服务端时使用（勿加 NEXT_PUBLIC_）---
# JWT_SECRET=
# VOLCANO_ARK_API_KEY=
# VOLCANO_ARK_BASE_URL=
# VOLCANO_ARK_MODEL_ENDPOINT=
# --- Xiaomi MiMo 语音（仅服务端）---
MIMO_API_KEY=
# Base URL 必须与控制台发放的 Key/区域/计费类型成对使用
# MIMO_API_BASE_URL=https://api.xiaomimimo.com/v1
# MIMO_TTS_MODEL=mimo-v2.5-tts
# MIMO_ASR_MODEL=mimo-v2.5-asr
# MIMO_TTS_VOICE=冰糖
# 所有尝试共享同一个总截止时间，必须短于 EdgeOne 60 秒函数上限
# MIMO_TIMEOUT_MS=45000

# --- 火山旧语音配置（迁移期保留，完成 MiMo 切换后删除）---
# VOLCANO_APP_ID=
# VOLCANO_ACCESS_TOKEN=
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM_NAME=
