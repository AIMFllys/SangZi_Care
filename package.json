{
  "name": "sangzi-smart-care",
  "version": "0.1.0",
  "private": true,
  "description": "桑梓智护 - 智护银龄 APP（EdgeOne 全栈 Next.js）",
  "scripts": {
    "dev": "next dev -p 7742",
    "prebuild": "node scripts/check-node-version.mjs",
    "build": "next build",
    "postbuild": "node scripts/check-build-budget.mjs",
    "start": "next start -p 7742",
    "test": "vitest run",
    "test:voice": "vitest run lib/server/__tests__/mimo.test.ts lib/audio/__tests__/wav.test.ts lib/audio/__tests__/recorder.test.ts hooks/__tests__/useTextToSpeech.test.ts hooks/__tests__/useVoiceRecognition.test.ts app/api/v1/voice/__tests__",
    "test:voice:live": "node --env-file=.env.local scripts/test-voice-live.mjs",
    "lint": "eslint .",
    "tsc": "tsc --noEmit"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "overrides": {
    "ws": "8.21.0",
    "postcss": "$postcss",
    "undici": "7.28.0",
    "vite": "7.3.6"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.49.8",
    "@types/nodemailer": "^8.0.1",
    "jose": "^6.2.3",
    "lucide-react": "^0.577.0",
    "next": "^16.2.10",
    "nodemailer": "^9.0.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "zustand": "^5.0.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@typescript-eslint/eslint-plugin": "^8.63.0",
    "@typescript-eslint/parser": "^8.63.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.2.10",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^28.1.0",
    "postcss": "^8.5.19",
    "tailwindcss": "^4.2.1",
    "typescript": "^5.8.3",
    "vitest": "^4.1.10"
  }
}
